#!/bin/sh
set -eu

case "${SSH_ORIGINAL_COMMAND:-}" in
  health)
    printf 'BLUEGUARD_RECEIVER_READY\n'
    ;;

  ingest)
    exec /usr/bin/python3 \
      /usr/local/libexec/blueguard-ingest-with-health.py
    ;;

  *)
    printf 'BlueGuard: operation not authorized\n' >&2
    exit 126
    ;;
esac
