[Unit]
Description=BlueGuard v0.4.0 Zeek JSONL collector (SSH push)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=blueguard-sender
Group=blueguard-sender
SupplementaryGroups=zeek
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/libexec/blueguard-zeek-collector --log-root /opt/zeek/logs --state-dir /var/lib/blueguard-sender/state --start-date 2026-11-19
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/blueguard-sender/state
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
